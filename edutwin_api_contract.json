{
  "_meta": {
    "project": "EduTwin — LLM-Powered Digital Twin of University Students",
    "version": "1.0.0",
    "description": "Full API contract between the frontend UI and the EduTwin backend. Each endpoint lists its required/optional frontend inputs and the exact shape of the backend response.",
    "base_url": "/api/v1",
    "global_constants": {
      "COURSE_TOPICS": [
        "linear_algebra",
        "probability",
        "python_basics",
        "data_structures",
        "ai_ml",
        "databases",
        "os_concepts",
        "networking"
      ],
      "WEAK_THRESHOLD": 0.50,
      "TARGET_SCORE": 0.70,
      "STUDENT_ID_RANGE": { "min": 1, "max": 60 },
      "INTERVENTION_TYPES": [
        "concept_learning",
        "increase_practice",
        "reduce_fatigue",
        "peer_study",
        "tutoring_session"
      ],
      "PERFORMANCE_LABELS": ["High", "Medium", "Low"],
      "RISK_LABELS": ["High Risk", "Medium Risk", "Low Risk"]
    }
  },

  "endpoints": [

    {
      "id": "build_profile",
      "route": "GET /profile/{student_id}",
      "description": "Builds (or returns cached) the Live Learner Profile (LLP) for one student. This is the foundational call — most other endpoints internally depend on the data returned here.",
      "frontend_inputs": {
        "path_params": {
          "student_id": {
            "type": "integer",
            "required": true,
            "min": 1,
            "max": 60,
            "ui_widget": "number_input or student_selector_dropdown",
            "label": "Student ID"
          }
        },
        "query_params": {
          "force_rebuild": {
            "type": "boolean",
            "required": false,
            "default": false,
            "label": "Force Rebuild Profile",
            "description": "If true, ignores cached profile and rebuilds from raw dataset."
          }
        }
      },
      "backend_response": {
        "student_id": { "type": "string", "example": "12" },
        "name":       { "type": "string", "example": "Jane Doe" },
        "year":       { "type": "integer", "example": 2, "range": [1, 4] },
        "branch":     { "type": "string", "enum": ["CSE", "IT", "ECE", "EEE"] },
        "archetype":  { "type": "string", "enum": ["strong", "average", "weak", "struggling"] },
        "knowledge": {
          "type": "object",
          "description": "Score per topic (0.0 to 1.0)",
          "properties": {
            "linear_algebra":  { "type": "number", "example": 0.72 },
            "probability":     { "type": "number", "example": 0.45 },
            "python_basics":   { "type": "number", "example": 0.81 },
            "data_structures": { "type": "number", "example": 0.60 },
            "ai_ml":           { "type": "number", "example": 0.38 },
            "databases":       { "type": "number", "example": 0.55 },
            "os_concepts":     { "type": "number", "example": 0.67 },
            "networking":      { "type": "number", "example": 0.49 }
          }
        },
        "weak_topics":   { "type": "array", "items": "string", "example": ["ai_ml", "probability", "networking"] },
        "strong_topics": { "type": "array", "items": "string", "example": ["python_basics", "linear_algebra"] },
        "behavior": {
          "type": "object",
          "properties": {
            "avg_time":       { "type": "number", "description": "Average minutes spent per topic", "example": 52.3 },
            "avg_attempts":   { "type": "number", "description": "Average number of attempts per topic", "example": 2.4 },
            "avg_confidence": { "type": "number", "range": [0, 1], "example": 0.55 },
            "engagement":     { "type": "number", "range": [0, 1], "example": 0.68 },
            "fatigue":        { "type": "number", "range": [0, 1], "example": 0.42 }
          }
        },
        "psychology": {
          "type": "object",
          "properties": {
            "confidence_level": { "type": "string", "enum": ["low", "medium", "high"] },
            "focus":            { "type": "string", "enum": ["low", "medium", "good"] },
            "engagement_level": { "type": "string", "enum": ["low", "medium", "high"] },
            "learning_pace":    { "type": "string", "enum": ["slow", "normal", "fast"] }
          }
        },
        "summary": { "type": "string", "description": "Human-readable one-paragraph profile summary generated by the backend." }
      }
    },

    {
      "id": "diagnose_weaknesses",
      "route": "GET /diagnose/{student_id}",
      "description": "Calls the LLM to identify the 2-3 most critical weak areas and produce actionable remediation advice for the student.",
      "frontend_inputs": {
        "path_params": {
          "student_id": {
            "type": "integer",
            "required": true,
            "ui_widget": "number_input or student_selector_dropdown",
            "label": "Student ID"
          }
        }
      },
      "backend_response": {
        "student_id":  { "type": "string" },
        "name":        { "type": "string" },
        "weak_topics": { "type": "array", "items": "string" },
        "llm_diagnosis": {
          "type": "string",
          "description": "Free-text LLM analysis: lists 2-3 critical weak areas, explains why each is weak, and recommends specific remedial actions. Max ~200 words."
        }
      }
    },

    {
      "id": "personalized_explanation",
      "route": "GET /explain/{student_id}/{concept}",
      "description": "Generates a personalised concept explanation tuned to the student's confidence level, weak areas, and learning pace. Uses RAG to inject relevant course material.",
      "frontend_inputs": {
        "path_params": {
          "student_id": {
            "type": "integer",
            "required": true,
            "ui_widget": "number_input or student_selector_dropdown",
            "label": "Student ID"
          },
          "concept": {
            "type": "string",
            "required": true,
            "enum": [
              "linear_algebra", "probability", "python_basics",
              "data_structures", "ai_ml", "databases", "os_concepts", "networking"
            ],
            "ui_widget": "dropdown",
            "label": "Topic / Concept"
          }
        }
      },
      "backend_response": {
        "student_id":  { "type": "string" },
        "name":        { "type": "string" },
        "concept":     { "type": "string" },
        "explanation": {
          "type": "string",
          "description": "LLM-generated explanation personalised to the student's profile. Uses analogies for low-confidence/slow learners; technical depth for strong students. Max ~250 words."
        },
        "profile_used": {
          "type": "object",
          "description": "Snapshot of key profile fields used to personalise the explanation.",
          "properties": {
            "confidence_level": { "type": "string" },
            "learning_pace":    { "type": "string" },
            "weak_topics":      { "type": "array", "items": "string" },
            "strong_topics":    { "type": "array", "items": "string" }
          }
        }
      }
    },

    {
      "id": "performance_prediction",
      "route": "GET /predict/{student_id}/{topic}",
      "description": "Uses the LLM to predict whether the student will score High, Medium, or Low on an upcoming assessment in the given topic, with a profile-backed justification.",
      "frontend_inputs": {
        "path_params": {
          "student_id": {
            "type": "integer",
            "required": true,
            "ui_widget": "number_input or student_selector_dropdown",
            "label": "Student ID"
          },
          "topic": {
            "type": "string",
            "required": true,
            "enum": [
              "linear_algebra", "probability", "python_basics",
              "data_structures", "ai_ml", "databases", "os_concepts", "networking"
            ],
            "ui_widget": "dropdown",
            "label": "Upcoming Assessment Topic"
          }
        }
      },
      "backend_response": {
        "student_id":        { "type": "string" },
        "name":              { "type": "string" },
        "topic":             { "type": "string" },
        "current_score_pct": { "type": "number", "description": "Current score in the topic as a percentage (0-100)", "example": 38.5 },
        "risk":              { "type": "string", "enum": ["High Risk", "Medium Risk", "Low Risk"] },
        "risk_score":        { "type": "number", "range": [0, 1] },
        "llm_prediction": {
          "type": "string",
          "description": "LLM free-text justification ending with 'Prediction: High / Medium / Low'."
        },
        "rule_based_prediction": {
          "type": "string",
          "enum": ["High", "Medium", "Low"],
          "description": "Rule-based prediction derived from risk score: risk > 0.60 => Low, 0.35-0.60 => Medium, < 0.35 => High."
        }
      }
    },

    {
      "id": "exam_simulation",
      "route": "POST /exam/{student_id}",
      "description": "Simulates the exam answer this student would write for a given question, including realistic knowledge gaps and misconceptions consistent with their profile.",
      "frontend_inputs": {
        "path_params": {
          "student_id": {
            "type": "integer",
            "required": true,
            "ui_widget": "number_input or student_selector_dropdown",
            "label": "Student ID"
          }
        },
        "body": {
          "topic": {
            "type": "string",
            "required": true,
            "enum": [
              "linear_algebra", "probability", "python_basics",
              "data_structures", "ai_ml", "databases", "os_concepts", "networking"
            ],
            "ui_widget": "dropdown",
            "label": "Topic"
          },
          "question": {
            "type": "string",
            "required": true,
            "max_length": 500,
            "ui_widget": "textarea",
            "label": "Exam Question",
            "placeholder": "e.g. Explain the bias-variance tradeoff in machine learning."
          }
        }
      },
      "backend_response": {
        "student_id":       { "type": "string" },
        "name":             { "type": "string" },
        "topic":            { "type": "string" },
        "topic_score_pct":  { "type": "number", "description": "Student's current score in this topic as a percentage." },
        "question":         { "type": "string" },
        "simulated_answer": {
          "type": "string",
          "description": "LLM-generated answer as the student would write it under exam conditions. Includes mistakes if score < 50%, minor gaps if > 70%. Max ~200 words."
        },
        "keyword_overlap": {
          "type": "number",
          "range": [0, 1],
          "description": "Fraction of expected domain keywords present in the simulated answer."
        }
      }
    },

    {
      "id": "study_plan",
      "route": "GET /plan/{student_id}",
      "description": "Generates a day-by-day personalised study plan that prioritises weak topics and respects the student's fatigue and engagement levels.",
      "frontend_inputs": {
        "path_params": {
          "student_id": {
            "type": "integer",
            "required": true,
            "ui_widget": "number_input or student_selector_dropdown",
            "label": "Student ID"
          }
        },
        "query_params": {
          "days": {
            "type": "integer",
            "required": false,
            "default": 7,
            "min": 1,
            "max": 30,
            "ui_widget": "number_input",
            "label": "Plan Duration (days)"
          }
        }
      },
      "backend_response": {
        "student_id":       { "type": "string" },
        "name":             { "type": "string" },
        "days":             { "type": "integer" },
        "weak_topics":      { "type": "array", "items": "string" },
        "fatigue_level":    { "type": "string", "enum": ["low", "medium", "good"] },
        "engagement_level": { "type": "string", "enum": ["low", "medium", "high"] },
        "study_plan": {
          "type": "string",
          "description": "LLM-generated day-by-day schedule. Each line: 'Day N: [topic] - [task] (duration)'. Fatigue-aware pacing applied."
        }
      }
    },

    {
      "id": "intervention_simulation",
      "route": "GET /simulate/{student_id}",
      "description": "Runs all five intervention strategies against the student's profile and returns the projected performance score for each, plus the recommended best strategy.",
      "frontend_inputs": {
        "path_params": {
          "student_id": {
            "type": "integer",
            "required": true,
            "ui_widget": "number_input or student_selector_dropdown",
            "label": "Student ID"
          }
        }
      },
      "backend_response": {
        "student_id":  { "type": "string" },
        "name":        { "type": "string" },
        "current_performance_pct": {
          "type": "number",
          "description": "Average topic score before any intervention, as a percentage."
        },
        "simulations": {
          "type": "object",
          "description": "Projected overall performance (%) per intervention strategy.",
          "properties": {
            "concept_learning":  { "type": "number", "example": 63.2 },
            "increase_practice": { "type": "number", "example": 65.8 },
            "reduce_fatigue":    { "type": "number", "example": 61.4 },
            "peer_study":        { "type": "number", "example": 64.1 },
            "tutoring_session":  { "type": "number", "example": 67.5 }
          }
        },
        "best_strategy": {
          "type": "string",
          "enum": ["concept_learning", "increase_practice", "reduce_fatigue", "peer_study", "tutoring_session"],
          "description": "Intervention that yields the highest projected performance."
        },
        "best_projected_performance_pct": { "type": "number", "example": 67.5 },
        "intervention_effects_reference": {
          "type": "object",
          "description": "The score_boost, conf_boost, and fatigue_delta constants used per strategy (from INTERVENTION_EFFECTS in digital_twin.py).",
          "properties": {
            "concept_learning":  { "score_boost": 0.08, "conf_boost": 0.05, "fatigue_delta": 0.05 },
            "increase_practice": { "score_boost": 0.10, "conf_boost": 0.12, "fatigue_delta": 0.10 },
            "reduce_fatigue":    { "score_boost": 0.03, "conf_boost": 0.08, "fatigue_delta": -0.20 },
            "peer_study":        { "score_boost": 0.07, "conf_boost": 0.10, "fatigue_delta": -0.05 },
            "tutoring_session":  { "score_boost": 0.12, "conf_boost": 0.15, "fatigue_delta": 0.02 }
          }
        }
      }
    },

    {
      "id": "apply_intervention",
      "route": "POST /simulate/{student_id}/apply",
      "description": "Applies a chosen intervention to the student's profile, persists the updated profile to memory, and returns the updated state.",
      "frontend_inputs": {
        "path_params": {
          "student_id": {
            "type": "integer",
            "required": true,
            "ui_widget": "number_input or student_selector_dropdown",
            "label": "Student ID"
          }
        },
        "body": {
          "action": {
            "type": "string",
            "required": true,
            "enum": ["concept_learning", "increase_practice", "reduce_fatigue", "peer_study", "tutoring_session"],
            "ui_widget": "radio_buttons or dropdown",
            "label": "Intervention Strategy to Apply"
          }
        }
      },
      "backend_response": {
        "student_id":             { "type": "string" },
        "name":                   { "type": "string" },
        "action_applied":         { "type": "string" },
        "performance_before_pct": { "type": "number" },
        "performance_after_pct":  { "type": "number" },
        "goal_achieved":          { "type": "boolean", "description": "True if all topic scores >= TARGET_SCORE (0.70) after intervention." },
        "updated_profile": {
          "type": "object",
          "description": "Full updated profile object — same shape as GET /profile/{student_id} response."
        }
      }
    },

    {
      "id": "feedback_loop",
      "route": "POST /feedback/{student_id}",
      "description": "Corrects the student's confidence estimate based on a real exam outcome. Updates the profile in memory using a 0.2 learning-rate correction: new_confidence = old + 0.2 * (actual - old).",
      "frontend_inputs": {
        "path_params": {
          "student_id": {
            "type": "integer",
            "required": true,
            "ui_widget": "number_input or student_selector_dropdown",
            "label": "Student ID"
          }
        },
        "body": {
          "actual_score": {
            "type": "number",
            "required": true,
            "min": 0.0,
            "max": 1.0,
            "ui_widget": "slider or number_input",
            "label": "Actual Exam Score (0.0 to 1.0)",
            "description": "The real score the student achieved. Used to correct the model's confidence estimate."
          }
        }
      },
      "backend_response": {
        "student_id":        { "type": "string" },
        "name":              { "type": "string" },
        "actual_score":      { "type": "number" },
        "confidence_before": { "type": "number", "description": "avg_confidence before correction." },
        "confidence_after":  { "type": "number", "description": "avg_confidence after 0.2 * error correction." },
        "updated_summary":   { "type": "string" },
        "goal_achieved":     { "type": "boolean" }
      }
    },

    {
      "id": "recommend_actions",
      "route": "GET /recommend/{student_id}",
      "description": "Returns the rule-based list of actionable recommendations derived from the student's psychology, behavior, and weak topics.",
      "frontend_inputs": {
        "path_params": {
          "student_id": {
            "type": "integer",
            "required": true,
            "ui_widget": "number_input or student_selector_dropdown",
            "label": "Student ID"
          }
        }
      },
      "backend_response": {
        "student_id": { "type": "string" },
        "name":       { "type": "string" },
        "recommendations": {
          "type": "array",
          "items": "string",
          "description": "Ordered list of actionable suggestion strings. Each addresses one specific profile signal (weak topics, fatigue, low confidence, high engagement, high attempts, slow pace).",
          "example": [
            "Focus on weak topics: ai_ml, probability",
            "Revise fundamentals and work through easier practice problems first.",
            "High fatigue — reduce daily study hours and add short breaks."
          ]
        }
      }
    },

    {
      "id": "teacher_overview",
      "route": "GET /teacher",
      "description": "Returns a class-wide summary: per-student risk levels and average scores, plus per-topic class averages. Intended for the teacher/admin dashboard.",
      "frontend_inputs": {
        "query_params": {
          "num_students": {
            "type": "integer",
            "required": false,
            "default": null,
            "description": "How many students to include (1 to 60). If null, all students in the dataset are used.",
            "min": 1,
            "max": 60,
            "ui_widget": "number_input",
            "label": "Number of Students to Include (leave blank for all)"
          }
        }
      },
      "backend_response": {
        "class_summary": {
          "total_students":    { "type": "integer" },
          "class_avg_pct":     { "type": "number", "description": "Mean overall score across all included students, as a percentage." },
          "high_risk_count":   { "type": "integer" },
          "medium_risk_count": { "type": "integer" },
          "low_risk_count":    { "type": "integer" },
          "goal_met_count":    { "type": "integer", "description": "Count of students with all topic scores >= 0.70." }
        },
        "students": {
          "type": "array",
          "description": "One entry per student, sorted by risk score descending (highest risk first).",
          "items": {
            "student_id":    { "type": "string" },
            "name":          { "type": "string" },
            "avg_score_pct": { "type": "number" },
            "risk":          { "type": "string", "enum": ["High Risk", "Medium Risk", "Low Risk"] },
            "risk_score":    { "type": "number", "range": [0, 1] },
            "weak_topics":   { "type": "array", "items": "string" }
          }
        },
        "topic_averages": {
          "type": "object",
          "description": "Class-average score per topic as a percentage.",
          "properties": {
            "linear_algebra":  { "type": "number" },
            "probability":     { "type": "number" },
            "python_basics":   { "type": "number" },
            "data_structures": { "type": "number" },
            "ai_ml":           { "type": "number" },
            "databases":       { "type": "number" },
            "os_concepts":     { "type": "number" },
            "networking":      { "type": "number" }
          }
        }
      }
    },

    {
      "id": "evaluation_pipeline",
      "route": "POST /evaluate",
      "description": "Runs the full 4-part evaluation pipeline (Weakness Diagnosis, Explanation Quality, Performance Prediction, Exam Simulation) and returns all metrics. Long-running — may take several minutes.",
      "frontend_inputs": {
        "body": {
          "student_ids": {
            "type": "array",
            "items": "integer",
            "required": false,
            "default": null,
            "description": "Subset of student IDs to evaluate. Omit or pass null to evaluate all students.",
            "ui_widget": "multi_select or leave_blank_for_all",
            "label": "Student IDs to Evaluate"
          }
        }
      },
      "backend_response": {
        "weakness_diagnosis": {
          "type": "object",
          "description": "Precision / Recall / F1 of the rule-based weak-topic detector vs ground truth.",
          "properties": {
            "mean_precision": { "type": "number", "range": [0, 1] },
            "mean_recall":    { "type": "number", "range": [0, 1] },
            "mean_f1":        { "type": "number", "range": [0, 1] },
            "n_students":     { "type": "integer" }
          }
        },
        "explanation_quality": {
          "type": "object",
          "description": "LLM-as-judge rating (1-5) for personalised explanation quality.",
          "properties": {
            "avg_llm_rating": { "type": "number", "range": [1, 5] },
            "max_rating":     { "type": "integer", "value": 5 },
            "n_evaluated":    { "type": "integer" },
            "details": {
              "type": "array",
              "items": {
                "student_id": { "type": "integer" },
                "concept":    { "type": "string" },
                "rating":     { "type": "integer", "range": [1, 5] }
              }
            }
          }
        },
        "performance_prediction": {
          "type": "object",
          "description": "3-class (High / Medium / Low) prediction accuracy and F1 vs naive always-Medium baseline.",
          "properties": {
            "accuracy":    { "type": "number", "range": [0, 1] },
            "weighted_f1": { "type": "number", "range": [0, 1] },
            "baseline_f1": { "type": "number", "range": [0, 1], "description": "Always-predict-Medium naive baseline weighted F1." },
            "n_students":  { "type": "integer" },
            "classification_report": {
              "type": "object",
              "description": "sklearn classification_report output_dict for High / Medium / Low labels. Contains per-class precision, recall, f1-score, support."
            }
          }
        },
        "exam_simulation": {
          "type": "object",
          "description": "Keyword-overlap analysis checking whether weak students use fewer domain keywords than strong students.",
          "properties": {
            "avg_kw_overlap":         { "type": "number", "range": [0, 1] },
            "weak_student_overlap":   { "type": ["number", "null"] },
            "strong_student_overlap": { "type": ["number", "null"] },
            "gap_weak_vs_strong": {
              "type": ["number", "null"],
              "description": "strong_overlap - weak_overlap. A positive value confirms the twin correctly differentiates weak vs strong students."
            },
            "n_evaluated": { "type": "integer" },
            "note":        { "type": "string" }
          }
        }
      }
    }

  ],

  "error_schema": {
    "description": "All endpoints return this shape on any error (4xx / 5xx).",
    "properties": {
      "status":  { "type": "string", "value": "error" },
      "code":    { "type": "integer", "description": "HTTP status code, e.g. 404, 422, 500." },
      "message": { "type": "string", "description": "Human-readable error message." },
      "detail":  { "type": ["string", "null"], "description": "Optional extended info / stack trace (dev mode only)." }
    }
  },

  "ui_component_hints": {
    "student_selector":    "Dropdown or search-by-name input bound to student IDs 1-60.",
    "topic_selector":      "Dropdown populated from the COURSE_TOPICS constant.",
    "llm_fields_note":     "Fields prefixed with 'llm_' contain free-text LLM output and may take 5-30 seconds. Show a streaming skeleton or loading indicator for these fields.",
    "risk_badge_colours": {
      "High Risk":   "red",
      "Medium Risk": "orange",
      "Low Risk":    "green"
    },
    "score_bar_colours": {
      "strong": "green  — score >= 0.70 (TARGET_SCORE)",
      "fair":   "amber  — 0.50 <= score < 0.70",
      "weak":   "red    — score < 0.50 (WEAK_THRESHOLD)"
    },
    "archetype_display": {
      "strong":     "High performer",
      "average":    "On track",
      "weak":       "Needs support",
      "struggling": "At risk"
    }
  }
}
